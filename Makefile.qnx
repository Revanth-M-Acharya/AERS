# ==============================================================================
# SMART AEGIS: Dedicated QNX Neutrino RTOS (SDP 8.0 / 7.1) Cross-Compilation Makefile
# Target: Raspberry Pi 4 Model B (Broadcom BCM2711, aarch64le)
#
# Usage:
#   make -f Makefile.qnx [ARCH=aarch64le] [BUILD_TYPE=Debug|Release|Profile]
# ==============================================================================

ARCH ?= aarch64le
BUILD_TYPE ?= Release

# Detect QNX Host Toolchain
ifdef QNX_HOST
    CXX = $(QNX_HOST)/usr/bin/q++
    CC  = $(QNX_HOST)/usr/bin/qcc
    AR  = $(QNX_HOST)/usr/bin/ntoaarch64-ar
    QCC_SPEC = gcc_nto$(ARCH)
    CXXFLAGS = -V$(QCC_SPEC)_cpp -Y_gpp -lang-c++ -w8 -std=c++17 \
               -D__QNX__ -D__QNXNTO__ -DAEGIS_TARGET_QNX=1 -D_QNX_SOURCE
    PLATFORM_LIBS = -lsocket
else
    # Fallback to local compiler for syntax/build verification when QNX_HOST not set
    CXX ?= c++
    CC  ?= cc
    AR  ?= ar
    CXXFLAGS = -std=c++17 -Wall -Wextra -DAEGIS_TARGET_QNX=1 -D_QNX_SOURCE
    PLATFORM_LIBS = -lpthread
endif

INCLUDES = -Iinclude -Isrc -Inetwork -I.

# Optimization & Debug Levels
ifeq ($(BUILD_TYPE),Release)
    CXXFLAGS += -O3 -DNDEBUG
else ifeq ($(BUILD_TYPE),Profile)
    CXXFLAGS += -O2 -g -p -DPROFILE -DAEGIS_PROFILE
else
    CXXFLAGS += -g -O0 -DAEGIS_DEBUG
endif

# Output Directories
BUILD_DIR = build-qnx
BIN_DIR   = $(BUILD_DIR)/bin
LIB_DIR   = $(BUILD_DIR)/lib
OBJ_DIR   = $(BUILD_DIR)/obj

