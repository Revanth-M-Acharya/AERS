HARDWARE_INT_OBJS = $(patsubst %.cpp,$(OBJ_DIR)/%.o,$(HARDWARE_INT_SRCS))
COMMAND_CENTER_OBJS = $(patsubst %.cpp,$(OBJ_DIR)/%.o,$(COMMAND_CENTER_SRCS))

STATIC_LIB = $(LIB_DIR)/libaegis.a

# Executables Suite (8 Target Executables + Aliases)
APPS = $(BIN_DIR)/coordinator \
       $(BIN_DIR)/traffic_node \
       $(BIN_DIR)/intersection \
       $(BIN_DIR)/simulation \
       $(BIN_DIR)/validator \
       $(BIN_DIR)/command_center \
       $(BIN_DIR)/digital_twin \
       $(BIN_DIR)/hardware_demo \
       $(BIN_DIR)/driver_dashboard \
       $(BIN_DIR)/priority_scheduler \
       $(BIN_DIR)/gui

.PHONY: all clean directories info

all: directories $(STATIC_LIB) $(APPS)
	@echo "=========================================================="
	@echo " SMART AEGIS QNX Build Complete [$(ARCH) - $(BUILD_TYPE)]"
	@echo " Binaries located in: $(BIN_DIR)"
	@echo "=========================================================="

directories:
	@mkdir -p $(BIN_DIR) $(LIB_DIR)
	@mkdir -p $(OBJ_DIR)/common $(OBJ_DIR)/config $(OBJ_DIR)/logger $(OBJ_DIR)/safety
	@mkdir -p $(OBJ_DIR)/network $(OBJ_DIR)/communication $(OBJ_DIR)/priority_scheduler $(OBJ_DIR)/route_planner
	@mkdir -p $(OBJ_DIR)/coordinator $(OBJ_DIR)/ambulance $(OBJ_DIR)/traffic_controller $(OBJ_DIR)/intersection $(OBJ_DIR)/system $(OBJ_DIR)/medical $(OBJ_DIR)/scheduler $(OBJ_DIR)/control $(OBJ_DIR)/traffic_signal $(OBJ_DIR)/green_corridor $(OBJ_DIR)/green_wave $(OBJ_DIR)/orchestrator $(OBJ_DIR)/replanning $(OBJ_DIR)/multi_corridor $(OBJ_DIR)/distributed_signal $(OBJ_DIR)/predictive_traffic $(OBJ_DIR)/fleet_management $(OBJ_DIR)/hospital_selection $(OBJ_DIR)/hospital_management $(OBJ_DIR)/mission_execution $(OBJ_DIR)/incident_command $(OBJ_DIR)/traffic_network_orchestrator $(OBJ_DIR)/distributed_consensus $(OBJ_DIR)/rpi_cluster $(OBJ_DIR)/system_diagnostics $(OBJ_DIR)/hardware_abstraction $(OBJ_DIR)/qnx_driver_framework $(OBJ_DIR)/bsp $(OBJ_DIR)/qnx_network $(OBJ_DIR)/runtime $(OBJ_DIR)/deployment $(OBJ_DIR)/simulator $(OBJ_DIR)/hardware
	@mkdir -p $(OBJ_DIR)/hospital_dashboard $(OBJ_DIR)/traffic_dashboard $(OBJ_DIR)/corridor $(OBJ_DIR)/cluster $(OBJ_DIR)/recovery $(OBJ_DIR)/qnx $(OBJ_DIR)/gpio $(OBJ_DIR)/intersection_service $(OBJ_DIR)/coordinator_client $(OBJ_DIR)/simulation
	@mkdir -p $(OBJ_DIR)/common/utils $(OBJ_DIR)/common/protocol $(OBJ_DIR)/common/config $(OBJ_DIR)/common/network
	@mkdir -p $(OBJ_DIR)/coordinator/logger $(OBJ_DIR)/coordinator/server $(OBJ_DIR)/coordinator/intelligence/graph $(OBJ_DIR)/coordinator/intelligence/planner $(OBJ_DIR)/coordinator/intelligence/eta $(OBJ_DIR)/coordinator/intelligence/scheduler $(OBJ_DIR)/coordinator/intelligence/corridor $(OBJ_DIR)/coordinator/intelligence/execution $(OBJ_DIR)/coordinator/intelligence/safety $(OBJ_DIR)/coordinator/intelligence/config
	@mkdir -p $(OBJ_DIR)/coordinator/orchestration/state $(OBJ_DIR)/coordinator/orchestration/event_bus $(OBJ_DIR)/coordinator/orchestration/session $(OBJ_DIR)/coordinator/orchestration/fsm $(OBJ_DIR)/coordinator/orchestration/dispatcher $(OBJ_DIR)/coordinator/orchestration/sync $(OBJ_DIR)/coordinator/orchestration/monitor $(OBJ_DIR)/coordinator/orchestration/recovery $(OBJ_DIR)/coordinator/orchestration/config
	@mkdir -p $(OBJ_DIR)/coordinator/control_center $(OBJ_DIR)/coordinator/hospital
	@mkdir -p $(OBJ_DIR)/coordinator/perception/analytics $(OBJ_DIR)/coordinator/perception/digital_twin
	@mkdir -p $(OBJ_DIR)/traffic_node/config $(OBJ_DIR)/traffic_node/logger $(OBJ_DIR)/traffic_node/gpio $(OBJ_DIR)/traffic_node/relay_controller $(OBJ_DIR)/traffic_node/lamp_controller $(OBJ_DIR)/traffic_node/signal_controller $(OBJ_DIR)/traffic_node/watchdog $(OBJ_DIR)/traffic_node/client $(OBJ_DIR)/traffic_node/protocol
	@mkdir -p $(OBJ_DIR)/digital_twin/visualizers $(OBJ_DIR)/production/health $(OBJ_DIR)/production/fault_tolerance $(OBJ_DIR)/production/communication $(OBJ_DIR)/production/security $(OBJ_DIR)/production/config $(OBJ_DIR)/production/reliability $(OBJ_DIR)/production/fault_injection $(OBJ_DIR)/production/benchmark
	@mkdir -p $(OBJ_DIR)/hardware_integration/gpio $(OBJ_DIR)/hardware_integration/led $(OBJ_DIR)/hardware_integration/relay $(OBJ_DIR)/hardware_integration/sensor $(OBJ_DIR)/hardware_integration/config $(OBJ_DIR)/hardware_integration/commissioning $(OBJ_DIR)/hardware_integration/cluster $(OBJ_DIR)/hardware_integration/validation $(OBJ_DIR)/hardware_integration/logging $(OBJ_DIR)/hardware_integration/demo
	@mkdir -p $(OBJ_DIR)/command_center/fleet $(OBJ_DIR)/command_center/tracking $(OBJ_DIR)/command_center/mission $(OBJ_DIR)/command_center/hospital $(OBJ_DIR)/command_center/traffic $(OBJ_DIR)/command_center/cluster $(OBJ_DIR)/command_center/health $(OBJ_DIR)/command_center/analytics $(OBJ_DIR)/command_center/replay $(OBJ_DIR)/command_center/dashboard $(OBJ_DIR)/command_center/bridge
	@mkdir -p $(OBJ_DIR)/apps

$(OBJ_DIR)/%.o: src/%.cpp | directories
	@echo "[CXX $<]"
	@$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

$(OBJ_DIR)/%.o: %.cpp | directories
	@echo "[CXX $<]"
	@$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

$(OBJ_DIR)/qnx_network/%.o: network/%.cpp | directories
	@echo "[CXX $<]"
	@$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

$(STATIC_LIB): $(ALL_OBJS) $(QNX_NET_OBJS) $(COORD_P2_OBJS) $(TRAFFIC_NODE_P3_OBJS) $(INTELLIGENCE_P4_OBJS) $(ORCHESTRATION_P5_OBJS) $(CONTROL_CENTER_P6_OBJS) $(HOSPITAL_P7_OBJS) $(PERCEPTION_OBJS) $(DIGITAL_TWIN_OBJS) $(PRODUCTION_OBJS) $(HARDWARE_INT_OBJS) $(COMMAND_CENTER_OBJS) | directories
	@echo "[AR $@] $(STATIC_LIB)"
	@$(AR) rcs $@ $^

